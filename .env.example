# ---- Required ----
# Postgres connection string (Railway gives you one). Only used to record purchases.
DATABASE_URL="postgresql://user:password@host:port/railway"
# The public web address. Local: http://localhost:3000
APP_URL="http://localhost:3000"

# ---- Payments ----
# Leave blank to use simulated payments (no Stripe account needed).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Only for a test copy on Railway without Stripe: "1" allows simulated (free) unlocks there.
ALLOW_SIMULATED_PAYMENTS=""

# ---- Amharic drafts ----
# "1" shows Amharic that Tsega hasn't approved yet (with a DRAFT label).
# Always on in local development; NEVER set this on the live site.
SHOW_AMHARIC_DRAFTS=""
